# Copy this file to .env and fill in your own values. .env is gitignored.

# Anthropic API key, used for topic + script generation (Claude Haiku).
# The code reads this via the standard anthropic SDK env var.
ANTHROPIC_API_KEY=your-key-here

# Optional: override the on-screen caption font. Defaults to fonts/georgiab.ttf.
# CAPTION_FONT=fonts/georgiab.ttf
